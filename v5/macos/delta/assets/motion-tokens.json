    "neverReadWallpaperPixels": true, "avoidCustomPerFrameShaders": true,
    "topNavyTintAlpha": [0.60, 0.72], "tunnelNavyTintAlpha": [0.78, 0.88],
    "preferredContrastColor": "#0E131F", "reduceTransparencyFallback": "#0E131F",
