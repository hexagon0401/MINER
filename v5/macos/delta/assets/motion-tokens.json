  "palette": {"cave": "#0E131F", "soil": "#27374B", "glass": "#DCE7EE", "start": "#0EFB2E", "stop": "#FF5A61", "success": "systemGreen", "primaryText": "#E6E8E6"},
  "verticalLayoutPt": {
